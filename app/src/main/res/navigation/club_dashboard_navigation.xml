<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/navigation_announcements">

    <fragment
        android:id="@+id/navigation_announcements"
        android:name="com.example.schoolclubsmanagementsystem.activities.clubDashboardUi.announcements.AnnouncementsFragment"
        android:label="Announcements"
        tools:layout="@layout/fragment_announcements">
        <argument
            android:name="clubId"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/navigation_enrollments"
        android:name="com.example.schoolclubsmanagementsystem.activities.clubDashboardUi.enrollments.EnrollmentsFragment"
        android:label="Enrollments"
        tools:layout="@layout/fragment_enrollments" />
    <fragment
        android:id="@+id/navigation_events"
        android:name="com.example.schoolclubsmanagementsystem.activities.clubDashboardUi.events.EventsFragment"
        android:label="Events"
        tools:layout="@layout/fragment_events" />
    <fragment
        android:id="@+id/navigation_payments"
        android:name="com.example.schoolclubsmanagementsystem.activities.clubDashboardUi.payments.PaymentsFragment"
        android:label="Payments"
        tools:layout="@layout/fragment_payments" />
    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.schoolclubsmanagementsystem.activities.clubDashboardUi.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />
</navigation>
