<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/home">

    <fragment
        android:id="@+id/home"
        android:name="com.example.schoolclubsmanagementsystem.activities.homeActivity.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/clubs_list"
        android:name="com.example.schoolclubsmanagementsystem.activities.clubListActivity.ClubListFragment"
        android:label="Clubs List"
        tools:layout="@layout/fragment_club_list" />

    <fragment
        android:id="@+id/my_clubs"
        android:name="com.example.schoolclubsmanagementsystem.activities.myClubsActivity.MyClubsFragment"
