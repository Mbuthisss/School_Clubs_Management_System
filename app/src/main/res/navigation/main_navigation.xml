    <fragment
        android:id="@+id/profile"
        android:name="com.example.schoolclubsmanagementsystem.activities.profileActivity.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/help"
        android:name="com.example.schoolclubsmanagementsystem.activities.helpActivity.HelpFragment"
