<?xml version="1.0" encoding="utf-8"?>

<!-- Layout Margin: Margin around each card; adjust as needed -->
<!-- Card Corner Radius: Rounded corners for the card -->
<!-- Card Elevation: Shadow for the card -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:backgroundTint="@color/white">


    <!-- Padding: Inner padding for card content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:orientation="vertical"
        android:padding="16dp">


        <!-- News Image (Optional) -->
        <!-- TODO: Src: Replace with actual image or URL -->
        <ImageView
            android:id="@+id/news_image"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/person" />

        <!-- News Title -->
        <!-- Text Size: Font size for the title -->
        <TextView
            android:id="@+id/news_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="News Title"
            android:textColor="@color/red"
            android:textSize="30sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- News Description -->
        <!-- Text Size: Font size for description -->
        <TextView
            android:id="@+id/news_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Short description or snippet of the news content."
            android:textColor="@color/black"
            android:textSize="20sp"
            android:layout_marginTop="4dp"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- Timestamp -->
        <!-- Text Size: Smaller font size for timestamp -->
        <TextView
            android:id="@+id/news_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 hours ago"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>


</androidx.cardview.widget.CardView>